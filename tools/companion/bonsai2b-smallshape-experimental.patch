+// A stored T2 row is rotated: decode four signed two-bit codes per byte, apply one
+// FP16 scale per 128 columns and inverse Walsh with sign-after.  This oracle does
+// not reuse the GPU producer or transform implementation.
+int run_embedding_rotated_t2_512(std::int32_t width) {
+    constexpr std::int32_t vocab = 4;
+    const std::vector<std::int32_t> ids = {3, 0, 2};
+    std::vector<std::uint8_t> codes(vocab * width / 4, 0);
+    std::vector<std::uint16_t> scales(vocab * width / 128, 0x3800u); // FP16: 0.5
+    std::vector<float> decoded(width * ids.size());
+    for (std::int32_t row = 0; row < vocab; ++row) {
+        for (std::int32_t j = 0; j < width; ++j) {
+            const int raw = (j * 7 + row * 5) % 3;
+            const std::uint8_t two_bit = raw == 2 ? 3 : static_cast<std::uint8_t>(raw);
+            codes[static_cast<std::size_t>(row) * width / 4 + j / 4] |=
+                static_cast<std::uint8_t>(two_bit << (2 * (j % 4)));
+        }
+    }
+    for (std::size_t t = 0; t < ids.size(); ++t) {
+        for (std::int32_t j = 0; j < width; ++j) {
+            const std::uint8_t byte = codes[static_cast<std::size_t>(ids[t]) * width / 4 + j / 4];
+            const int raw = (byte >> (2 * (j % 4))) & 3;
+            decoded[t * width + j] = (raw == 3 ? -0.5F : raw == 1 ? 0.5F : 0.0F);
+        }
+    }
+    const auto signs = random_signs(width, 13221U);
+    auto d_codes = to_device(codes);
+    auto d_scales = to_device(scales);
+    auto d_ids = to_device(ids);
+    auto d_signs = to_device_bf16(signs);
+    GuardedDeviceBuffer output(width * ids.size() * sizeof(std::uint16_t));
+    output.fill(0xff);
+    Weight table{};
+    table.qtype = QType::T2_G128_FP16;
+    table.layout = QuantLayout::RowSplit;
+    table.scale_dtype = DType::FP16;
+    table.qdata = d_codes.p;
+    table.scales = d_scales.p;
+    table.k = width;
+    table.n = vocab;
+    Tensor token_tensor(d_ids.p, DType::I32, {static_cast<int>(ids.size())});
+    Tensor sign_tensor(d_signs.p, DType::BF16, {width});
