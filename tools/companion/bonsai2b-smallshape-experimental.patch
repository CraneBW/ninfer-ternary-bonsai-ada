+// Bonsai 2B has 16 control heads and 2048 input channels. Larger-model
+// kernels hardcode 32 or 48 heads, so use a correct shape-specific SIMT path.
+__global__ void bf16_gdn_gating_proj_2b_kernel(
+    const __nv_bfloat16* __restrict__ x, const __nv_bfloat16* __restrict__ a,
+    const __nv_bfloat16* __restrict__ b, const float* __restrict__ A_log,
+    const float* __restrict__ dt_bias, float* __restrict__ g,
+    float* __restrict__ beta) {
+    constexpr int kInput = 2048;
+    constexpr int kHeads = 16;
+    constexpr int kBlock = 256;
+    const int head = static_cast<int>(blockIdx.x);
+    const int token = static_cast<int>(blockIdx.y);
+    const int thread = static_cast<int>(threadIdx.x);
+    __shared__ float a_sums[kBlock];
+    __shared__ float b_sums[kBlock];
+    float sum_a = 0.0f;
+    float sum_b = 0.0f;
+    for (int k = thread; k < kInput; k += kBlock) {
+        const float activation = __bfloat162float(x[token * kInput + k]);
+        sum_a = fmaf(activation, __bfloat162float(a[head * kInput + k]), sum_a);
+        sum_b = fmaf(activation, __bfloat162float(b[head * kInput + k]), sum_b);
+    }
+    a_sums[thread] = sum_a;
+    b_sums[thread] = sum_b;
+    __syncthreads();
+    for (int stride = kBlock / 2; stride > 0; stride >>= 1) {
+        if (thread < stride) {
+            a_sums[thread] += a_sums[thread + stride];
+            b_sums[thread] += b_sums[thread + stride];
+        }
+        __syncthreads();
+    }
+    if (thread == 0) {
+        const int dst = token * kHeads + head;
+        g[dst] = -expf(A_log[head]) * softplus(a_sums[0] + dt_bias[head]);
+        beta[dst] = sigmoid(b_sums[0]);
+    }
