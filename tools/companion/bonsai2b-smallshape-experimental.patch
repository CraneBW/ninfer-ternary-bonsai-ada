+__device__ __forceinline__ void
+hadamard_512_butterfly(float (&v)[kHadamardSmallLaneVectors][8], int lane) {
+#pragma unroll
+    for (int stride = 1; stride < 8; stride <<= 1) {
+#pragma unroll
+        for (int r = 0; r < kHadamardSmallLaneVectors; ++r) {
+#pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                if ((j & stride) == 0) {
+                    const float lo = v[r][j], hi = v[r][j + stride];
+                    v[r][j] = __fadd_rn(lo, hi);
+                    v[r][j + stride] = __fsub_rn(lo, hi);
+                }
+            }
+        }
+    }
+#pragma unroll
+    for (int stride = 1; stride < kWarpSize; stride <<= 1) {
+#pragma unroll
+        for (int r = 0; r < kHadamardSmallLaneVectors; ++r) {
+#pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                const float peer = __shfl_xor_sync(kFullWarpMask, v[r][j], stride);
+                v[r][j] = (lane & stride) == 0 ? __fadd_rn(v[r][j], peer)
+                                               : __fsub_rn(peer, v[r][j]);
+            }
+        }
+    }
+#pragma unroll
+    for (int j = 0; j < 8; ++j) {
+        const float lo = v[0][j], hi = v[1][j];
+        v[0][j] = __fadd_rn(lo, hi);
+        v[1][j] = __fsub_rn(lo, hi);
+    }
+}
+
