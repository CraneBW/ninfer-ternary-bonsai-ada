+// The small Bonsai 2B v3 converter records 512-point Hadamard blocks. Keeping
+// this as a separate kernel specialization preserves the original 27B 1024
+// arithmetic/rounding behavior rather than silently mixing two bases.
+inline constexpr int kHadamardSmallBlock = 512;
+inline constexpr int kHadamardSmallLaneVectors = kHadamardSmallBlock / (kWarpSize * 8);
+inline constexpr float kHadamardSmallNormalizer = 0.04419417382415922f;
